CONFIG_BOARD_TOOLCHAIN="arm-none-eabi"
CONFIG_BOARD_ARCHITECTURE="cortex-m7"
CONFIG_BOARD_ROMFSROOT="micoair_raw_imu"
CONFIG_BOARD_SERIAL_URT6="/dev/ttyS5"
CONFIG_BOARD_SERIAL_GPS1="/dev/ttyS2"
CONFIG_BOARD_SERIAL_TEL1="/dev/ttyS0"
CONFIG_BOARD_SERIAL_TEL2="/dev/ttyS1"
CONFIG_BOARD_SERIAL_TEL3="/dev/ttyS3"
CONFIG_BOARD_SERIAL_TEL4="/dev/ttyS6"
CONFIG_BOARD_SERIAL_RC="/dev/ttyS4"
# Diagnostic stage 2: link the ICM42688P command, but keep board-level SPI
# initialization disabled through BOARD_SD_ONLY_DIAGNOSTIC.
CONFIG_DRIVERS_IMU_INVENSENSE_ICM42688P=y
# Keep the module linked (but never start it in rcS) so the minimal build
# retains the NuttX px4_task_spawn_cmd implementation required by work queues.
CONFIG_MODULES_LOGGER=y
CONFIG_SYSTEMCMDS_DMESG=y
CONFIG_SYSTEMCMDS_NSHTERM=y
CONFIG_SYSTEMCMDS_PARAM=y
CONFIG_SYSTEMCMDS_PERF=y
CONFIG_SYSTEMCMDS_REBOOT=y
CONFIG_SYSTEMCMDS_TOP=y
CONFIG_SYSTEMCMDS_TOPIC_LISTENER=y
CONFIG_SYSTEMCMDS_UORB=y
CONFIG_SYSTEMCMDS_USB_CONNECTED=y
CONFIG_SYSTEMCMDS_VER=y
CONFIG_SYSTEMCMDS_WORK_QUEUE=y
CONFIG_SYSTEMCMDS_GPIO=y
