#!/bin/sh
#
# board specific sensors init
#------------------------------------------------------------------------------

if [ $IMU_FIFO_LOG_ONLY != yes ]
then
	board_adc start
fi

# # SPI bus ICM42688 accel/gyro
icm42688p -s -b 1 -R 0 start

# SPI bus ICM45686 accel/gyro
icm45686 -s -b 1 -R 0 start
