{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "jlink (@PX4_BOARD@)",
            "gdbPath": "@VSCODE_GDB_PATH@",
            "device": "@DEBUG_DEVICE@",
            "svdFile": "@DEBUG_SVD_FILE_PATH@",
            "rtos": "@JLINK_RTOS_PATH@",
            "executable": "${workspaceFolder}/build/@PX4_CONFIG@/@PX4_CONFIG@.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "jlink",
            "serverpath": "C:/Program Files/SEGGER/JLink_V798f/JLinkGDBServerCL.exe",
            "interface": "swd",
            "cwd": "${workspaceFolder}",
            "internalConsoleOptions": "openOnSessionStart",
            "overrideLaunchCommands": [
                "monitor reset",
                "monitor halt",
                "load",
                "set $sp = *(unsigned long *)0x08020000",
                "set $pc = *(unsigned long *)0x08020004"
            ],
            "overrideRestartCommands": [
                "monitor reset",
                "monitor halt",
                "load",
                "set $sp = *(unsigned long *)0x08020000",
                "set $pc = *(unsigned long *)0x08020004"
            ],
            "postLaunchCommands": [
                "set mem inaccessible-by-default off",
                "set print pretty"
            ]
        }
    ]
}
