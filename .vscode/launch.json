{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "J-Link: micoair_h743-v2 烧录并调试",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/micoair_h743-v2_default/micoair_h743-v2_default.elf",
            "device": "STM32H743VI",
            "interface": "swd",
            "serverpath": "/usr/bin/JLinkGDBServerCLExe",
            "gdbPath": "/opt/gcc-arm-none-eabi-10-2020-q4-major/bin/arm-none-eabi-gdb",
            "armToolchainPath": "/opt/gcc-arm-none-eabi-10-2020-q4-major/bin",
            "toolchainPrefix": "arm-none-eabi",
            "objdumpPath": "/opt/gcc-arm-none-eabi-10-2020-q4-major/bin/arm-none-eabi-objdump",
            "serverArgs": [
                "-speed",
                "4000",
                "-strict",
                "-timeout",
                "5000",
                "-vd"
            ],
            "gdbServerConsolePort": 53233,
            "internalConsoleOptions": "openOnSessionStart",
            "showDevDebugOutput": "parsed",
            "swoConfig": {
                "enabled": false
            },
            "rttConfig": {
                "enabled": false
            },
            "overrideLaunchCommands": [
                "set mem inaccessible-by-default off",
                "set print pretty",
                "monitor reset",
                "monitor halt",
                "load",
                "set $sp = *(unsigned long *)0x08020000",
                "set $pc = *(unsigned long *)0x08020004"
            ],
            "overrideRestartCommands": [
                "set mem inaccessible-by-default off",
                "set print pretty",
                "monitor reset",
                "monitor halt",
                "set $sp = *(unsigned long *)0x08020000",
                "set $pc = *(unsigned long *)0x08020004"
            ],
            "postLaunchCommands": [
                "set print pretty"
            ]
        }
    ]
}
