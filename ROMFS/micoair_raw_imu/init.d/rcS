#!/bin/sh

set +e

ver all

set SDCARD_AVAILABLE no
set FEXTRAS /fs/microsd/etc/extras.txt
set START_FIFO_LOGGER no

# The custom minimal ROMFS does not preserve empty directories.
if [ ! -d "/fs/microsd" ]
then
	mkdir /fs/microsd
fi

# The SDIO block driver is initialized by board_app_initialize() before rcS.
if [ -b "/dev/mmcsd0" ]
then
	# Media-change probing is handled asynchronously by NuttX. The original
	# full PX4 boot naturally spends enough time here; this minimal rcS does not.
	sleep 1

	if mount -t vfat /dev/mmcsd0 /fs/microsd
	then
		set SDCARD_AVAILABLE yes
		echo "INFO [init] microSD mounted at /fs/microsd"
	else
		echo "WARN [init] microSD mount attempt 1/3 failed; retrying"
		sleep 1

		if mount -t vfat /dev/mmcsd0 /fs/microsd
		then
			set SDCARD_AVAILABLE yes
			echo "INFO [init] microSD mounted at /fs/microsd"
		else
			echo "WARN [init] microSD mount attempt 2/3 failed; retrying"
			sleep 1

			if mount -t vfat /dev/mmcsd0 /fs/microsd
			then
				set SDCARD_AVAILABLE yes
				echo "INFO [init] microSD mounted at /fs/microsd"
			else
				echo "ERROR [init] failed to mount /dev/mmcsd0 after 3 attempts"
			fi
		fi
	fi
else
	echo "ERROR [init] microSD block device /dev/mmcsd0 not found"
fi

# Minimal runtime diagnostic build. SD mounting is handled here, while SPI
# sensors and logger are optionally started by the SD-card extras.txt script.
# USB remains an interactive NSH shell through BOARD_USB_NSH_ONLY.
if [ $SDCARD_AVAILABLE = yes ]
then
	echo "INFO [init] minimal diagnostic: microSD is ready"
	df

	# Keep board-specific runtime choices on the SD card. This matches the
	# standard PX4 extras.txt hook and allows IMUs/logger to be enabled or
	# disabled without rebuilding the firmware.
	if [ -f $FEXTRAS ]
	then
		echo "INFO [init] running addons script: ${FEXTRAS}"
		. $FEXTRAS
	fi

	# Never start SD writing from the sysinit/rcS call stack. Start a separate
	# NSH task that waits until this script has returned, then starts Logger.
	if [ $START_FIFO_LOGGER = yes ]
	then
		echo "INFO [init] scheduling automatic FIFO logging after sysinit"
		nsh /etc/init.d/rc.fifo_logger &
	fi
else
	echo "ERROR [init] minimal diagnostic: microSD is not ready"
fi

unset FEXTRAS
unset START_FIFO_LOGGER
unset SDCARD_AVAILABLE
